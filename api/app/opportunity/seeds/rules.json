{
  "version": 1,
  "kind": "opportunity_rules",
  "meta": {
    "name": "新机会的免费闸",
    "description": "决定哪些帖子值得问模型，以及材料多于预算时先问谁。发现靠查询清单，不靠这里。",
    "updated_at": "2026-10-18"
  },
  "levels": [
    {"id": "S", "label": "强信号", "min_score": 90},
    {"id": "A", "label": "高优先级", "min_score": 60},
    {"id": "B", "label": "观察", "min_score": 30}
  ],
  "rules": [
    {
      "id": "exclude-trade-gated",
      "name": "排除交易门槛类",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {"type": "text_contains_any", "values": [
          "trading competition", "trade to earn", "trading volume", "deposit to",
          "合约交易赛", "交易赛", "充值", "入金", "杠杆", "合约新币", "首笔交易",
          "futures", "perpetual", "leverage"
        ]}
      ],
      "effect": {"action": "exclude", "score": 0, "level": ""}
    },
    {
      "id": "exclude-retweet",
      "name": "排除转发",
      "enabled": true,
      "operator": "AND",
      "conditions": [{"type": "is_retweet"}],
      "effect": {"action": "exclude", "score": 0, "level": ""}
    },
    {
      "id": "action-keywords",
      "name": "行动词",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {"type": "text_contains_any", "values": [
          "空投", "白名单", "测试网", "水龙头", "积分", "任务", "签到", "领取", "报名",
          "公测", "内测", "免费", "零成本", "打新", "认购", "挖矿", "挂机", "质押",
          "airdrop", "whitelist", "allowlist", "testnet", "devnet", "faucet", "points",
          "quest", "claim", "mint", "check-in", "waitlist", "early access", "beta",
          "invite code", "sign up", "signup", "register", "reward", "campaign"
        ]}
      ],
      "effect": {"action": "score", "score": 40, "level": "B"}
    },
    {
      "id": "early-words",
      "name": "早期入口",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {"type": "text_contains_any", "values": [
          "introducing", "announcing", "we built", "looking for testers", "beta testers",
          "call for testers", "founding engineer", "early access", "waitlist", "invite code"
        ]}
      ],
      "effect": {"action": "score", "score": 30, "level": "B"}
    },
    {
      "id": "launch-words",
      "name": "上线与首发",
      "enabled": true,
      "operator": "AND",
      "conditions": [
        {"type": "text_contains_any", "values": [
          "is live", "now live", "we're live", "mainnet", "launch", "launched", "上线",
          "主网", "发布", "首发", "public beta", "genesis"
        ]}
      ],
      "effect": {"action": "score", "score": 25, "level": "B"}
    },
    {
      "id": "unknown-author",
      "name": "不在 watchlist 里的账号",
      "enabled": true,
      "operator": "AND",
      "conditions": [{"type": "author_not_known"}],
      "effect": {"action": "score", "score": 25, "level": "B"}
    },
    {
      "id": "fresh",
      "name": "新鲜（24 小时内）",
      "enabled": true,
      "operator": "AND",
      "conditions": [{"type": "age_within_days", "value": 1}],
      "effect": {"action": "score", "score": 20, "level": ""}
    },
    {
      "id": "has-link",
      "name": "带链接",
      "enabled": true,
      "operator": "AND",
      "conditions": [{"type": "has_link"}],
      "effect": {"action": "score", "score": 10, "level": ""}
    },
    {
      "id": "some-attention",
      "name": "有一点关注",
      "enabled": true,
      "operator": "AND",
      "conditions": [{"type": "metric_at_least", "metric": "views", "value": 100}],
      "effect": {"action": "score", "score": 10, "level": ""}
    }
  ]
}
